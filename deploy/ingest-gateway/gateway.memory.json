{
  "data_listen": ":4318",
  "admin_listen": ":9464",
  "signals": ["logs", "traces"],
  "max_body_bytes": 4194304,
  "kafka": {
    "mode": "memory",
    "topic_logs": "logs.raw",
    "topic_traces": "traces.raw"
  },
  "snapshot": {
    "path": "deploy/ingest-gateway/snapshot.dev.json",
    "reload_interval": "15s",
    "fresh_on_load": true
  }
}
