# 统一行尾：仓库内一律 LF，避免 Windows / Linux 混合开发产生整文件 diff
* text=auto eol=lf

*.go      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf

*.bat     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.jpg     binary
*.ico     binary
*.woff2   binary
